.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Data: keep example 04's real parquet (small, the one real-data pipeline),
# ignore everything else — synthetic CSVs are regenerable via make_data.py
*.csv
*.parquet
!examples/04_nyc_taxi_fare/data/*.parquet

# Logs are commited
# so logs/ is NOT ignored.  Individual make_data log files are scratch.
logs/make_data_*.log
